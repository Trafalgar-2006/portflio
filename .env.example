# ─────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values you need:
#
#     cp .env.example .env
#
# `.env` is gitignored — your real keys never get committed.
# The app reads it automatically at startup; nothing to type in the shell.
#
# PRECEDENCE: real environment variables always win over this file. That way
# a stale .env inside a deployed image can never override what Railway /
# Oracle / Docker inject at runtime.
#
# Every variable below is OPTIONAL except SSH_ENABLED. Features whose keys
# are missing simply stay switched off — nothing breaks.
#
# Point at a different file with DOTENV_PATH=config/local.env
# ─────────────────────────────────────────────────────────────────────────


# ── Server ───────────────────────────────────────────────────────────────
# "true" starts the SSH server; "false" (or unset) runs the TUI locally.
SSH_ENABLED=true

# SSH listener.
HOST=0.0.0.0
SSH_PORT=23234

# HTTP listener for the web portfolio + /health.
# Most PaaS platforms inject this themselves — leave it to default to 8080.
PORT=8080

# Base64-encoded ed25519 private key, so the SSH fingerprint survives
# redeploys and visitors don't get "REMOTE HOST IDENTIFICATION HAS CHANGED".
#   ssh-keygen -t ed25519 -f host_key -N ""
#   base64 -w0 host_key
# SSH_HOST_KEY=<PASTE_BASE64_HOST_KEY_HERE>


# ── GitHub project auto-sync ─────────────────────────────────────────────
# Polls the GitHub API and merges your public repos into the project list,
# so pushing a new repo makes it appear without a redeploy.
# content.yaml always wins: curated projects are never overwritten.
GITHUB_USER=trafalgar-2006

# Personal access token. Optional, and needs NO scopes for public repos —
# it only raises the API rate limit from 60/hour to 5000/hour.
# Create at: https://github.com/settings/tokens
# GITHUB_TOKEN=<PASTE_GITHUB_TOKEN_HERE>

# Repos to keep OFF the portfolio (comma-separated, case-insensitive).
# Auto-sync otherwise publishes every public repo, including scratch
# workspaces and one-off experiments.
# GITHUB_EXCLUDE=sar2eo-workspace,info.slide,rapidfire

# Set to "false" to disable the sync worker entirely.
GITHUB_SYNC=true

# How often to poll (Go duration; minimum 1m).
SYNC_INTERVAL=1h


# ── Guestbook ────────────────────────────────────────────────────────────
# Append-only JSONL file. Mount this path on a volume to persist across
# deploys, otherwise messages are lost when the container is replaced.
GUESTBOOK_PATH=data/guestbook.jsonl

# Messages kept in memory (older ones remain on disk).
GUESTBOOK_MAX=500


# ── Admin dashboard ──────────────────────────────────────────────────────
# SSH public keys allowed to see live server stats (uptime, sessions, heap,
# goroutines, sync status). LEAVE UNSET TO DISABLE THE ADMIN VIEW ENTIRELY.
#
# Accepts full authorized_keys lines OR bare SHA256: fingerprints,
# separated by commas or newlines. Get yours with:
#   cat ~/.ssh/id_ed25519.pub
#   ssh-keygen -lf ~/.ssh/id_ed25519.pub     # the SHA256:... form
#
# ADMIN_SSH_KEYS="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA<PASTE_YOUR_PUBLIC_KEY_HERE> you@laptop"
#
# Multiple keys:
# ADMIN_SSH_KEYS="ssh-ed25519 AAAA...laptop,ssh-ed25519 AAAA...desktop"


# ── WakaTime (optional) ──────────────────────────────────────────────────
# Adds a coding-time and language breakdown panel to the admin dashboard.
# The panel is omitted entirely when this is unset.
# Key from: https://wakatime.com/settings/api-key
# WAKATIME_API_KEY=<PASTE_WAKATIME_API_KEY_HERE>

# How often to refresh (Go duration; minimum 1m).
# WAKATIME_INTERVAL=30m

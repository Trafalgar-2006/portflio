# SSH server mode (set to "true" to start the SSH server; "false" runs the TUI locally)
SSH_ENABLED=true

# SSH listener
HOST=0.0.0.0
SSH_PORT=23234

# HTTP listener for the web portfolio + /health.
# Most PaaS platforms inject this automatically — leave unset to default to 8080.
PORT=8080

# Base64-encoded ed25519 private key, so the host fingerprint survives redeploys.
# Generate with: base64 -w0 .ssh/id_ed25519
# SSH_HOST_KEY=

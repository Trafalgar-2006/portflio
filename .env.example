# ── Server ───────────────────────────────────────────────────────────────
# SSH server mode (set to "true" to start the SSH server; "false" runs the TUI locally)
SSH_ENABLED=true

# SSH listener
HOST=0.0.0.0
SSH_PORT=23234

# HTTP listener for the web portfolio + /health.
# Most PaaS platforms inject this automatically — leave unset to default to 8080.
PORT=8080

# Base64-encoded ed25519 private key, so the host fingerprint survives redeploys.
# Generate with: base64 -w0 .ssh/id_ed25519
# SSH_HOST_KEY=

# ── GitHub project auto-sync ─────────────────────────────────────────────
# Polls the GitHub API and merges public repos into the project list, so a new
# repo appears on the portfolio without a redeploy. content.yaml always wins:
# curated projects are never overwritten.
GITHUB_USER=trafalgar-2006
# Optional PAT — raises the API rate limit from 60/h to 5000/h.
# GITHUB_TOKEN=
# Set to "false" to disable the worker entirely.
GITHUB_SYNC=true
# Poll interval (Go duration, minimum 1m).
SYNC_INTERVAL=1h

# ── Guestbook ────────────────────────────────────────────────────────────
# Append-only JSONL file. Mount this path on a volume to persist across deploys.
GUESTBOOK_PATH=data/guestbook.jsonl
# Messages retained in memory (older ones stay on disk).
GUESTBOOK_MAX=500

# ── Admin dashboard ──────────────────────────────────────────────────────
# SSH public keys allowed to see live server stats. Accepts full
# authorized_keys lines or bare SHA256: fingerprints, comma/newline separated.
# Leave unset to disable the admin view entirely.
# ADMIN_SSH_KEYS=ssh-ed25519 AAAAC3Nza... you@laptop

# ── WakaTime (optional) ──────────────────────────────────────────────────
# Coding-time and language breakdown on the admin dashboard.
# The panel is omitted entirely when this is unset.
# WAKATIME_API_KEY=
# WAKATIME_INTERVAL=30m
